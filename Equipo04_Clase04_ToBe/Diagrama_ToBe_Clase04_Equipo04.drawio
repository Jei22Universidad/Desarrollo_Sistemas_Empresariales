        <mxCell id="laneP" value="Proveedor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="2925.0" height="120" as="geometry" /></mxCell>
        <mxCell id="laneA" value="Almacén" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="2925.0" height="240" as="geometry" /></mxCell>
        <mxCell id="st1" value="Necesidad de intervención sobre equipo (preventivo/correctivo)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="70" height="70" as="geometry" /></mxCell>
        <mxCell id="tb1" value="Identificar repuesto — catálogo digital con especificaciones técnicas del equipo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="170" y="111" width="240" height="58" as="geometry" /></mxCell>
        <mxCell id="tb2" value="Diligenciar solicitud digital con campos obligatorios — reemplaza la solicitud verbal y sus 2 reprocesos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="455" y="111" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="tb3" value="Consultar disponibilidad en tiempo real — sistema propuesto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="455" y="636" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="d1" value="¿Cantidad suficiente?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="745" y="627" width="110" height="76" as="geometry" /></mxCell>
        <mxCell id="tb4" value="Entregar el repuesto al técnico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="915" y="634" width="150" height="62" as="geometry" /></mxCell><mxCell id="tb5" value="Registrar la salida con la persona que retira" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1215" y="634" width="150" height="62" as="geometry" /></mxCell><mxCell id="tb6" value="Actualizar el stock automáticamente — sistema propuesto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1390" y="634" width="150" height="62" as="geometry" /></mxCell>
        <mxCell id="d2" value="¿Cantidad entregada correcta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1090" y="627" width="100" height="76" as="geometry" /></mxCell>
        <mxCell id="tb4b" value="Ajustar entrega o informar diferencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1070" y="732" width="190" height="46" as="geometry" /></mxCell>
        <mxCell id="d3" value="¿Existencia por debajo del mínimo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=7;" vertex="1" parent="1"><mxGeometry x="1565" y="627" width="100" height="76" as="geometry" /></mxCell>
        <mxCell id="ef" value="Repuesto entregado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=7;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1690" y="635" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="talert" value="Alerta automática de stock bajo y solicitud de compra sugerida — sistema propuesto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1505" y="728" width="260" height="54" as="geometry" /></mxCell>
        <mxCell id="tbhist" value="Consultar información histórica instantánea — sistema propuesto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=8;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="455" y="730" width="250" height="50" as="geometry" /></mxCell>
        <mxCell id="tcot" value="Solicitar cotización al proveedor — como hoy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1865" y="111" width="250" height="58" as="geometry" /></mxCell>
        <mxCell id="tapr" value="Autorización de Gerencia — se mantiene como hoy, fuera del sistema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1845" y="246" width="290" height="58" as="geometry" /></mxCell>
        <mxCell id="tsap" value="Registrar solicitud de compra en SAP — como hoy; la conexión con SAP queda por evaluar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2200" y="111" width="260" height="58" as="geometry" /></mxCell>
        <mxCell id="tcomp" value="Recibir la solicitud y generar la orden de compra al proveedor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2215" y="347" width="230" height="56" as="geometry" /></mxCell>
        <mxCell id="dprov" value="¿Proveedor puede suministrar a tiempo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2515" y="337" width="110" height="76" as="geometry" /></mxCell>
        <mxCell id="talt" value="Buscar proveedor alternativo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2230" y="426" width="200" height="44" as="geometry" /></mxCell>
        <mxCell id="tprov" value="Confirmar y despachar pedido — llega en 3 a 4 días" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2660" y="523" width="240" height="54" as="geometry" /></mxCell>
        <mxCell id="trec" value="Recibir repuesto y registrar entrada en el sistema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2655" y="730" width="250" height="50" as="geometry" /></mxCell>
        <mxCell id="legend" value="Leyenda:&#xa;Fondo gris = paso NUEVO o MEJORADO  |  Fondo blanco = sin cambio respecto al As-Is&#xa;Borde punteado = excepción / retrabajo  |  Rombo = decisión&#xa;&#xa;Decisiones de diseño:&#xa;- Sistema propio y ligero de inventario y órdenes de trabajo, complementario a SAP.&#xa;- El sistema se limita a inventario, stock mínimo, alertas y registro de entradas y salidas.&#xa;- SAP se mantiene para presupuesto y proveedores; conectarlo al sistema es una posibilidad futura, por evaluar.&#xa;- El formulario y el catálogo obligatorios eliminan las 2 decisiones de reproceso de la solicitud.&#xa;- Entrada y salida se registran en el mismo acto, con la persona que retira; el stock se actualiza solo y la alerta es automática.&#xa;- La cotización, la autorización de Gerencia y el pedido en SAP se mantienen como hoy, fuera del sistema.&#xa;&#xa;Restricciones que el sistema no modifica (confirmadas por el Supervisor de Mantenimiento):&#xa;- El repuesto llega 3 a 4 días después de la solicitud y autorización (≈1 día).&#xa;- El proceso de compra se mantiene igual: el beneficio es anticipar el faltante.&#xa;- Gerencia no rechaza (el repuesto es indispensable): la autorización es un control formal que sigue como hoy." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="820" height="300" as="geometry" /></mxCell>
