        <mxCell id="laneC" value="Compras" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="2840.0" height="170" as="geometry" /></mxCell>
        <mxCell id="laneP" value="Proveedor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="2840.0" height="120" as="geometry" /></mxCell>
        <mxCell id="laneA" value="Almacén" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="2840.0" height="240" as="geometry" /></mxCell>
        <mxCell id="st1" value="Necesidad de intervención sobre equipo (preventivo/correctivo)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="70" height="70" as="geometry" /></mxCell>
        <mxCell id="a2" value="Identificar repuesto requerido (10-15 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="170" y="115" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="d3" value="¿Repuesto identificado con precisión?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="375" y="102" width="110" height="76" as="geometry" /></mxCell>
        <mxCell id="a3b" value="Consultar información adicional del equipo, incl. especificaciones técnicas (+15-30 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="305" y="43" width="250" height="44" as="geometry" /></mxCell>
        <mxCell id="a4" value="Solicitar repuesto a almacén — verbal (5 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="690" y="115" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="a5b" value="Completar información de la solicitud (+1 hora)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="405" y="184" width="230" height="42" as="geometry" /></mxCell>
        <mxCell id="mcot" value="Solicitar cotización al proveedor por correo — Supervisor de Mantenimiento (60 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1335" y="113" width="230" height="54" as="geometry" /></mxCell>
        <mxCell id="mauth" value="Solicitar autorización a Gerencia — Supervisor de Mantenimiento (60 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1595" y="113" width="230" height="54" as="geometry" /></mxCell>
        <mxCell id="msap" value="Generar solicitud de compra en SAP — Supervisor de Mantenimiento (30 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1900" y="113" width="240" height="54" as="geometry" /></mxCell>
        <mxCell id="gauth" value="Autorizar la compra con sello (30 min); siempre se autoriza, no hay rechazo. Si Gerencia no está: un compañero autorizado asume o se autoriza por correo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1560" y="246" width="300" height="58" as="geometry" /></mxCell>
        <mxCell id="a9" value="Recibir la solicitud por correo y contactar al proveedor habitual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1905" y="348" width="230" height="54" as="geometry" /></mxCell>
        <mxCell id="a11" value="Generar la orden de compra y hacerla llegar al proveedor (≈1 día)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2170" y="348" width="200" height="54" as="geometry" /></mxCell>
        <mxCell id="d10b" value="¿Proveedor puede suministrar a tiempo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="2425" y="337" width="110" height="76" as="geometry" /></mxCell>
        <mxCell id="a11b" value="Buscar proveedor alternativo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2170" y="426" width="200" height="44" as="geometry" /></mxCell>
        <mxCell id="a13" value="Confirmar y despachar pedido — llega en 3 a 4 días" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2580" y="523" width="240" height="54" as="geometry" /></mxCell>
        <mxCell id="d5" value="¿Solicitud completa?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="735" y="627" width="110" height="76" as="geometry" /></mxCell>
        <mxCell id="a6" value="Consultar existencias en la hoja de control física (15 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="890" y="640" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="tbhist" value="Consultar información histórica — registros manuales dispersos (30-60 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="895" y="730" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="d7" value="¿Cantidad suficiente?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1105" y="627" width="110" height="76" as="geometry" /></mxCell>
        <mxCell id="a8" value="Identificar faltante y necesidad de compra (60 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1100" y="731" width="230" height="48" as="geometry" /></mxCell>
        <mxCell id="a12" value="Entregar repuesto al técnico (5 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1265" y="640" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="d15" value="¿Cantidad entregada correcta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1485" y="627" width="110" height="76" as="geometry" /></mxCell>
        <mxCell id="a15b" value="Ajustar entrega o informar diferencia (+10 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1430" y="732" width="220" height="46" as="geometry" /></mxCell>
        <mxCell id="a16" value="Registrar salida de inventario (5 min) — se anota en el libro, pero no siempre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1625" y="638" width="210" height="54" as="geometry" /></mxCell>
        
        
        <mxCell id="ef" value="Repuesto entregado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontSize=7;" vertex="1" parent="1"><mxGeometry x="2265" y="630" width="70" height="70" as="geometry" /></mxCell>
        <mxCell id="a14" value="Recibir repuesto y registrar entrada (20 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2580" y="731" width="240" height="48" as="geometry" /></mxCell>
        <mxCell id="legend" value="Leyenda:&#10;Recuadro blanco = actividad  |  Rombo = decisión  |  Fondo gris = excepción / retrabajo&#10;Línea punteada = retorno de un retrabajo o consulta transversal&#10;&#10;Los tiempos entre paréntesis son de trabajo; los que llevan + son adicionales por reproceso.&#10;Detalle completo: Tabla de tiempos y evidencia (Actividad 5).&#10;&#10;Hechos confirmados por el Supervisor de Mantenimiento:&#10;- La solicitud de repuesto es verbal; todo el registro es en papel.&#10;- Salida de inventario: se anota en un libro, pero no siempre (por el afán o cuando el Supervisor no está); el stock disponible no se actualiza.&#10;- SAP: el Supervisor lo usa solo para presupuesto y proveedores (compras); su módulo de inventario no lo conoce ni lo usa.&#10;- Si Gerencia no está, un compañero autorizado asume o se autoriza por correo.&#10;- Desde la solicitud o aprobación pasa ≈1 día; el repuesto llega 3 a 4 días después.&#10;- Faltante detectado tarde: 5 a 7 veces por semana (a veces una vez al día).&#10;- Gerencia no rechaza: el repuesto es indispensable. No existe inventario sistematizado (≈500 referencias)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="820" height="260" as="geometry" /></mxCell>
